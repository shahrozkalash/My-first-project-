# StoryMotion AI - Environment Variables
# 100% Zero-Cost Local Setup: No paid APIs, cloud services, or subscriptions required.

# Local WAN 2.1 Video Inference Server URL (defaults to http://127.0.0.1:8000)
# Run scripts/run_local_wan.bat (Windows) or scripts/run_local_wan.sh (Linux/macOS)
WAN_ENGINE_URL=http://127.0.0.1:8000

# Open-source model name: wan-2.1-t2v-1.4b (8GB-12GB VRAM) or wan-2.1-t2v-14b (24GB+ VRAM)
WAN_MODEL=wan-2.1-t2v-1.4b

# Optional: GEMINI_API_KEY for advanced AI story brainstorming (Free tier supported).
# If omitted, StoryMotion AI automatically uses the built-in local heuristic director engine at 0 cost.
GEMINI_API_KEY=