# AI Studio Environment Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key for server-side story and script generation (optional)
GEMINI_API_KEY=

# Local WAN 2.1 Video Engine & Windows Helper (optional local GPU inference)
WAN_ENGINE_URL=http://127.0.0.1:8000
WAN_MODEL=wan-2.1-t2v-1.4b
WAN_ENGINE_TOKEN=
